{
  "pulseaudio": {
    "format": "{icon}  {volume}",
    "format-muted": "<span foreground='#d67b76'>  Muted</span>",
    "format-icons": {
      "headphone": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "max-volume": 150,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip": false
  }
}
