font=monospace 11
background-color=#2e3440
text-color=#d8dee9
border-color=#88c0d0
border-size=2
border-radius=0
padding=10,12
margin=20
width=320
height=100
anchor=top-right
default-timeout=5000
ignore-timeout=1
max-history=100

[urgency=low]
border-color=#4c566a

[urgency=normal]
border-color=#88c0d0

[urgency=high]
border-color=#bf616a
text-color=#bf616a

# Bar › Style island: the island shows new notifications, mako only keeps them
[mode=island]
invisible=1

# Appearance › Corners round: the shell turns this mode on
[mode=round]
border-radius=10
