font=monospace 11
background-color=#191724
text-color=#e0def4
border-color=#c4a7e7
border-size=2
border-radius=0
padding=10,12
margin=20
width=320
height=100
anchor=top-right
default-timeout=5000
ignore-timeout=1
max-history=100

[urgency=low]
border-color=#403d52

[urgency=normal]
border-color=#c4a7e7

[urgency=high]
border-color=#eb6f92
text-color=#eb6f92

# Bar › Style island: the island shows new notifications, mako only keeps them
[mode=island]
invisible=1

# Appearance › Corners round: the shell turns this mode on
[mode=round]
border-radius=10
