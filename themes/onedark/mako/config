font=monospace 11
background-color=#282c34
text-color=#abb2bf
border-color=#61afef
border-size=2
border-radius=0
padding=10,12
margin=20
width=320
height=100
anchor=top-right
default-timeout=5000
ignore-timeout=1
max-history=100

[urgency=low]
border-color=#3e4451

[urgency=normal]
border-color=#61afef

[urgency=high]
border-color=#e06c75
text-color=#e06c75

# Bar › Style island: the island shows new notifications, mako only keeps them
[mode=island]
invisible=1

# Appearance › Corners round: the shell turns this mode on
[mode=round]
border-radius=10
