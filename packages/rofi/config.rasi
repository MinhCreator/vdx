configuration {
    modes: "apps:~/.config/rofi/apps.sh,scripts:~/.config/rofi/scripts.sh,boot:~/.config/rofi/boot.sh";
    show-icons: false;
    display-apps: "Apps";
    display-scripts: "Scripts";
    display-boot: "Boot";
    kb-mode-next: "Tab";
    kb-mode-previous: "Shift+Tab";
    kb-element-next: "";
    kb-element-prev: "";
    kb-custom-1: "Left";
    kb-move-char-back: "Control+b";
    kb-move-char-forward: "Control+f";
    kb-accept-entry: "Right,Control+j,Control+m,Return,KP_Enter";
}

@import "~/.config/rofi/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Bold 11";
}

window {
    transparency: "real";
    width: 260px;
    border: 4px;
    border-color: @border;
    background-color: @bg;
    location: center;
    anchor: center;
}

mainbox {
    padding: 15px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    margin: 0 0 12px 0;
    padding: 0 0 12px 0;
    border: 0px 0px 2px 0px;
    border-color: @fg;
    children: [ "entry" ];
}

entry {
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @fg;
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
    border: 0px;
}

element {
    padding: 0px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: transparent;
    text-color: @accent;
    border: 0px;
    border-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.0;
}
