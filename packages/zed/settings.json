// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
  "vim_mode": false,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "ui_font_weight": 500,
  "buffer_font_size": 16,
  "buffer_font_weight": 500,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Material"
  },
  "project_panel": {
    "dock": "left",
    "starts_open": true
  },
  "tab_bar": {
    "show": true
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "status_bar": {
    "experimental.show": false
  },
  "scrollbar": {
    "show": "never"
  }
}
