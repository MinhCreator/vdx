{
  "custom/media_title": {
    "format": "{}",
    "return-type": "json",
    "interval": 1,
    "exec": "~/.config/waybar/scripts/media.sh --title-json",
    "max-length": 60,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/media.sh --toggle",
    "on-click-right": "kitty --class ncmpcpp -e ncmpcpp"
  }
}
